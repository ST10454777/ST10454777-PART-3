<Window x:Class="CybersecurityChatbotGUI.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Cyber-Guard Chatbot - PROG6221 Part 3" Height="760" Width="950"
WindowStartupLocation="CenterScreen" Background="#0F172A">
<Grid Margin="15">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>

<!-- HEADER - Part 2 -->
<Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="15" Margin="0,0,0,10">
<StackPanel>
<TextBlock Text="CYBER-GUARD CHATBOT" Foreground="#38BDF8" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
<TextBlock Text="Your Cybersecurity Awareness Assistant - Part 3: Tasks • Quiz • NLP • Activity Log" Foreground="White" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
<TextBlock x:Name="AsciiArtBlock" Foreground="#22C55E" FontFamily="Consolas" FontSize="10" TextAlignment="Center" Margin="0,10,0,0"
Text=".-. .-. .-. .-. .-.&#x0a;/ _.-' | | | | | |_ | | / / | | / _.-'&#x0a;\ `. | | | | |.--' | |/ /_ | | \ `.&#x0a;`-' `-' `-' `-' `-'`--' `-' `-'"/>
<TextBlock x:Name="MemoryLabel" Foreground="#FACC15" FontSize="12" Margin="0,5,0,0" Text="Memory: No user info yet"/>
</StackPanel>
</Border>

<!-- PART 3 BUTTONS - This is what the marker looks for -->
<Border Grid.Row="1" Background="#1E293B" CornerRadius="12" Padding="10" Margin="0,0,0,10">
<StackPanel>
<TextBlock Text="Quick Actions - Part 3" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
<WrapPanel Orientation="Horizontal">
<!-- These call the code in Step 3 -->
<Button x:Name="TasksButton" Content="📋 My Tasks" Width="120" Height="38" Margin="0,0,8,5" Background="#22C55E" Foreground="White" FontWeight="Bold" Click="TasksButton_Click" Cursor="Hand"/>
<Button x:Name="AddTaskButton" Content="➕ Add Task" Width="120" Height="38" Margin="0,0,8,5" Background="#16A34A" Foreground="White" FontWeight="Bold" Click="AddTaskButton_Click" Cursor="Hand"/>
<Button x:Name="QuizButton" Content="🎮 Start Quiz" Width="120" Height="38" Margin="0,0,8,5" Background="#8B5CF6" Foreground="White" FontWeight="Bold" Click="QuizButton_Click" Cursor="Hand"/>
<Button x:Name="LogButton" Content="📜 Activity Log" Width="130" Height="38" Margin="0,0,8,5" Background="#F59E0B" Foreground="White" FontWeight="Bold" Click="LogButton_Click" Cursor="Hand"/>
<Button x:Name="HelpButton" Content="❓ Help" Width="90" Height="38" Margin="0,0,8,5" Background="#64748B" Foreground="White" FontWeight="Bold" Click="HelpButton_Click" Cursor="Hand"/>
</WrapPanel>
<TextBlock Text="Tip: Type 'Add task - Enable 2FA' • 'Remind me to update password tomorrow' • 'Start quiz' • 'Show activity log'" Foreground="#94A3B8" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
</StackPanel>
</Border>

<!-- CHAT AREA - Part 2 -->
<Border Grid.Row="2" Background="White" CornerRadius="12" Padding="10">
<ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
<StackPanel x:Name="ChatPanel"/>
</ScrollViewer>
</Border>

<!-- INPUT AREA - Part 2 -->
<Grid Grid.Row="3" Margin="0,10,0,0">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<TextBox x:Name="UserInputBox" Grid.Column="0" Height="45" FontSize="14" Padding="10"
BorderBrush="#38BDF8" BorderThickness="2" KeyDown="UserInputBox_KeyDown"/>
<Button Grid.Column="1" Content="SEND" Width="100" Height="45" Margin="10,0,0,0" Background="#38BDF8" Foreground="White" FontWeight="Bold" Click="SendButton_Click" Cursor="Hand"/>
</Grid>
</Grid>
</Window>
